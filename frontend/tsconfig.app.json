{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDir": "./",
    // "paths": {
    //   "@/*": ["src/*"]
    // },
    "allowSyntheticDefaultImports": true, 
    "esModuleInterop": true
  },
  "include": ["src"]
}
